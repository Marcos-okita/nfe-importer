# Copie este arquivo para ".env" (ja ignorado pelo git) e preencha com os valores reais do seu
# ambiente. Veja o README para detalhes de cada variavel.

# --- Banco de dados (MariaDB) ---
DB_URL=jdbc:mariadb://localhost:3306/nfe_importer
DB_USERNAME=nfe_importer
DB_PASSWORD=troque-esta-senha

# --- Integracao com a SEFAZ (NFe Distribuicao de DFe) ---
NFE_CNPJ=00000000000000
NFE_UF=SP
NFE_AMBIENTE=homologacao
NFE_CERT_PATH=./cert/seu-certificado.pfx
NFE_CERT_PASSWORD=troque-esta-senha

# --- Integracao com o mercadinho (encaminha o XML de cada NF-e importada) ---
MERCADINHO_API=https://mercadinho.vitainformatica.com/
MERCADINHO_TOKEN=troque-este-token
